{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tokentracker.cc/schemas/token-observability-v2.schema.json",
  "title": "Token Observability v2",
  "type": "object",
  "definitions": {
    "dataEvidenceV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_kind", "accuracy", "coverage", "observed_at", "source_updated_at", "stale_after_seconds", "is_stale", "pricing_source", "pricing_version", "note_code"],
      "properties": {
        "source_kind": { "enum": ["official_api", "session_log", "sqlite", "hook", "otel", "cache", "estimated", "user_override"] },
        "accuracy": { "enum": ["exact", "normalized", "estimated", "unknown"] },
        "coverage": { "enum": ["complete", "partial", "unavailable", "unpriced"] },
        "observed_at": { "type": "string", "format": "date-time" },
        "source_updated_at": { "type": ["string", "null"], "format": "date-time" },
        "stale_after_seconds": { "type": "integer", "minimum": 0 },
        "is_stale": { "type": "boolean" },
        "pricing_source": { "type": ["string", "null"] },
        "pricing_version": { "type": ["string", "null"] },
        "note_code": { "type": ["string", "null"] }
      }
    },
    "usageDimensionsV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device_id", "environment_id", "environment_kind", "agent_id", "account_scope", "project_key", "session_key", "model_id"],
      "properties": {
        "device_id": { "type": "string", "minLength": 1 },
        "environment_id": { "type": "string", "minLength": 1 },
        "environment_kind": { "enum": ["native", "wsl", "ssh", "container", "unknown"] },
        "agent_id": { "type": "string", "minLength": 1 },
        "account_scope": { "type": ["string", "null"] },
        "project_key": { "type": ["string", "null"] },
        "session_key": { "type": ["string", "null"] },
        "model_id": { "type": ["string", "null"] }
      }
    },
    "tokenFields": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "cached_input_tokens", "cache_creation_input_tokens", "output_tokens", "reasoning_output_tokens", "total_tokens", "conversation_count"],
      "properties": {
        "input_tokens": { "type": ["integer", "string"], "minimum": 0 },
        "cached_input_tokens": { "type": ["integer", "string"], "minimum": 0 },
        "cache_creation_input_tokens": { "type": ["integer", "string"], "minimum": 0 },
        "output_tokens": { "type": ["integer", "string"], "minimum": 0 },
        "reasoning_output_tokens": { "type": ["integer", "string"], "minimum": 0 },
        "total_tokens": { "type": ["integer", "string"], "minimum": 0 },
        "conversation_count": { "type": ["integer", "string"], "minimum": 0 }
      }
    },
    "usageSnapshotV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "hour_start", "dimensions", "tokens"],
      "properties": {
        "schema_version": { "const": "token-observability/v2" },
        "hour_start": { "type": ["string", "null"], "format": "date-time" },
        "dimensions": { "$ref": "#/definitions/usageDimensionsV1" },
        "tokens": { "$ref": "#/definitions/tokenFields" }
      }
    },
    "limitWindowV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "label", "used_percent", "reset_at", "window_seconds", "evidence"],
      "properties": {
        "kind": { "enum": ["five_hour", "seven_day", "monthly", "custom"] },
        "label": { "type": "string" },
        "used_percent": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "reset_at": { "type": ["string", "null"], "format": "date-time" },
        "window_seconds": { "type": ["integer", "null"], "minimum": 0 },
        "evidence": { "$ref": "#/definitions/dataEvidenceV1" }
      }
    },
    "limitAccountV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_id", "account_key", "account_label", "plan_label", "status", "windows", "last_success_at", "error_code"],
      "properties": {
        "provider_id": { "type": "string", "minLength": 1 },
        "account_key": { "type": "string", "minLength": 1 },
        "account_label": { "type": "string", "minLength": 1 },
        "plan_label": { "type": ["string", "null"] },
        "status": { "enum": ["ok", "stale", "unavailable", "auth_error", "rate_limited"] },
        "windows": { "type": "array", "items": { "$ref": "#/definitions/limitWindowV2" } },
        "last_success_at": { "type": ["string", "null"], "format": "date-time" },
        "error_code": { "type": ["string", "null"] }
      }
    },
    "requestDiagnosticV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "timestamp", "dimensions", "requested_model", "response_model", "pricing_model", "input_tokens", "output_tokens", "cached_input_tokens", "cache_creation_input_tokens", "reasoning_output_tokens", "success", "status_code", "latency_ms", "first_token_ms", "total_cost_usd", "unpriced_tokens", "evidence"],
      "properties": {
        "request_id": { "type": "string", "minLength": 1 },
        "timestamp": { "type": "string", "format": "date-time" },
        "dimensions": { "$ref": "#/definitions/usageDimensionsV1" },
        "requested_model": { "type": ["string", "null"] },
        "response_model": { "type": ["string", "null"] },
        "pricing_model": { "type": ["string", "null"] },
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "cached_input_tokens": { "type": "integer", "minimum": 0 },
        "cache_creation_input_tokens": { "type": "integer", "minimum": 0 },
        "reasoning_output_tokens": { "type": "integer", "minimum": 0 },
        "success": { "type": ["boolean", "null"] },
        "status_code": { "type": ["integer", "null"], "minimum": 100, "maximum": 599 },
        "latency_ms": { "type": ["integer", "null"], "minimum": 0 },
        "first_token_ms": { "type": ["integer", "null"], "minimum": 0 },
        "total_cost_usd": { "type": ["string", "null"] },
        "unpriced_tokens": { "type": "integer", "minimum": 0 },
        "evidence": { "$ref": "#/definitions/dataEvidenceV1" }
      }
    }
  }
}
