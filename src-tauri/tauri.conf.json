{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Token Eyes",
  "version": "0.54.35",
  "identifier": "com.tokeneyes.desktop",
  "build": {
    "frontendDist": "../dashboard/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix dashboard run dev -- --host 127.0.0.1",
    "beforeBuildCommand": "npm run dashboard:build && npm run tauri:prepare-runtime"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Token Eyes",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https: http:; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https: http:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Muxunson",
    "icon": [
      "icons/token-eyes-orange/32x32.png",
      "icons/token-eyes-orange/128x128.png",
      "icons/token-eyes-orange/128x128@2x.png",
      "icons/token-eyes-orange/icon.icns",
      "icons/token-eyes-orange/icon.ico"
    ],
    "resources": [
      "EmbeddedServer-0.54.35/**/*"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/token-eyes-orange/icon.ico",
        "uninstallerIcon": "icons/token-eyes-orange/icon.ico",
        "installerHooks": "windows/nsis-hooks.nsh"
      }
    }
  }
}
