    {
      "id": "oauth-secrets-never-enter-a-second-request-or-report",
      "document": {
        "_meta": {
          "schema_version": 1,
          "updated_at": "2026-08-20"
        },
        "links": [
          {
            "link_id": "synthetic-live-oauth-secret",
            "source_type": "official_document",
            "url": "https://vendor.example/plans",
            "allowed_hosts": ["vendor.example", "login.identity.example"],
            "expected_final": {
              "url": "https://vendor.example/plans",
              "path": "/plans"
            }
          }
        ]
      },
      "responses": [
        {
          "url": "https://vendor.example/plans",
          "status": 302,
          "headers": {
            "location": "https://login.identity.example/signin?code=SYNTHETIC_OAUTH_CODE&state=SYNTHETIC_OAUTH_STATE&ticket=SYNTHETIC_OAUTH_TICKET&continue=https%3A%2F%2Fcallback.example%2F%3Fid_token%3DSYNTHETIC_NESTED_ID_TOKEN#access_token=SYNTHETIC_FRAGMENT_ACCESS_TOKEN"
          }
        }
      ],
      "forbidden_values": [
        "SYNTHETIC_OAUTH_CODE",
        "SYNTHETIC_OAUTH_STATE",
        "SYNTHETIC_OAUTH_TICKET",
        "SYNTHETIC_NESTED_ID_TOKEN",
        "SYNTHETIC_FRAGMENT_ACCESS_TOKEN"
      ],
      "expected": {
        "exit_code": 0,
        "emitted_reports": 1,
        "output": "external-links-report.json",
        "classification": "requires_login",
        "final": "https://login.identity.example/signin?redacted",
        "request_urls": [
          "https://vendor.example/plans"
        ],
        "forbidden_values_present": []
      }
    },
    {
      "id": "unknown-future-credential-is-never-followed-or-reported",
